        {
          "name": "5. POST /api/events/{id}/register - Success (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Aarav Patel\",\n  \"roll_number\": \"26CS089\",\n  \"email\": \"aarav.patel@zenith.edu\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Valid student registration for Event 1. Returns 201 Created with RegistrationOut."
          },
          "response": []
        },
        {
          "name": "6. POST /api/events/{id}/register - Missing Required Field (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"\",\n  \"roll_number\": \"26CS089\",\n  \"email\": \"aarav.patel@zenith.edu\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Tests server-side validation error 400 Bad Request when student_name is empty."
          },
          "response": []
        },
        {
          "name": "7. POST /api/events/{id}/register - Invalid Email (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Aarav Patel\",\n  \"roll_number\": \"26CS089\",\n  \"email\": \"not-a-valid-email\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Tests server-side validation error 400 Bad Request when email does not contain '@'."
          },
          "response": []
        },
        {
          "name": "8. POST /api/events/{id}/register - Duplicate Email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Aarav Patel Duplicate\",\n  \"roll_number\": \"26CS089\",\n  \"email\": \"aarav.patel@zenith.edu\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Tests conflict error 409 when the same email attempts to register for the same event twice."
          },
          "response": []
        },
        {
          "name": "9. GET /api/registrations (All Registrations)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"]
            },
            "description": "Returns full list of registrations with joined event_title."
          },
          "response": []
        },
        {
          "name": "10. GET /api/registrations (Filter by Event ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registrations?event_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"],
              "query": [
                {
                  "key": "event_id",
                  "value": "1",
                  "description": "Filter to registrations for event 1"
                }
              ]
            },
            "description": "Returns registrations specifically for event_id 1."
          },
          "response": []
        }
      ]
    },
