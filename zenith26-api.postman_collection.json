{
  "info": {
    "_postman_id": "c148449b-zenith26-api-collection",
    "name": "Zenith '26 Fest Management System API",
    "description": "Complete Postman testing collection for the Zenith '26 College Fest Management System API (FastAPI + SQLite). Includes success and failure verification for PM2-01 & PM2-02.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "1. GET /api/events (All Events)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            },
            "description": "Returns list of all 14 events with live available_seats computed from database."
          },
          "response": []
        },
        {
          "name": "2. GET /api/events (Filter Category & Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technical&search=Code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "category",
                  "value": "Technical",
                  "description": "Category filter"
                },
                {
                  "key": "search",
                  "value": "Code",
                  "description": "Case-insensitive title search"
                }
              ]
            },
            "description": "Filters events by category and title search query parameter."
          },
          "response": []
        },
        {
          "name": "3. GET /api/events/{event_id} (Success - Event 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1"]
            },
            "description": "Returns full details for Event ID 1 (Code Sprint 2.0)."
          },
          "response": []
        },
        {
          "name": "4. GET /api/events/{event_id} (Not Found - 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "9999"]
            },
            "description": "Tests 404 response when requesting a non-existent event ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Registrations",
